# Copy this file to .env and replace every change-me value before starting Compose.
POSTGRES_USER=lumina
POSTGRES_PW=change-me-database-password
POSTGRES_DB=lumina

# Auth service
AUTH_DB_URL=jdbc:postgresql://localhost:5432/lumina
AUTH_DB_USERNAME=lumina
AUTH_DB_PASSWORD=change-me-database-password
AUTH_DB_SCHEMA=auth
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
# Optional first-Tutor bootstrap. Leave all three blank to disable it.
BOOTSTRAP_TUTOR_EMAIL=
BOOTSTRAP_TUTOR_PASSWORD=
BOOTSTRAP_TUTOR_FULL_NAME=

# Grading service
GRADING_DB_URL=jdbc:postgresql://localhost:5432/lumina
GRADING_DB_USERNAME=lumina
GRADING_DB_PASSWORD=change-me-database-password
GRADING_DB_SCHEMA=grading
AI_ENGINE_URL=https://api.openai.com/v1/chat/completions
AI_ENGINE_MODEL=gpt-5.6-terra
AI_ENGINE_API_KEY=
AI_VISION_MODEL=gpt-5.6-terra
# Vision OCR is invoked only by learning-service. Use the OpenAI-compatible
# endpoint and a real secret outside version control in production.
AI_VISION_ENABLED=true
AI_VISION_URL=${AI_ENGINE_URL}
# Leave blank to reuse AI_ENGINE_API_KEY; do not use NEXT_PUBLIC_ variables.
AI_VISION_API_KEY=
AI_VISION_TIMEOUT_MS=30000
AI_VISION_MAX_REQUESTS_PER_MINUTE=20
AI_VISION_MAX_ATTEMPTS=3
AI_VISION_RETRY_DELAY_MS=60000
AI_VISION_STALE_RUN_MS=180000
AI_VISION_WORKER_DELAY_MS=5000
# Shared only between grading-service and learning-service. Generate a
# separate high-entropy value; do not use a NEXT_PUBLIC_ variable.
LEARNING_MARKING_SYNC_KEY=change-me-to-a-separate-high-entropy-service-key

# Learning service
LEARNING_DB_URL=jdbc:postgresql://localhost:5432/lumina
LEARNING_DB_USERNAME=lumina
LEARNING_DB_PASSWORD=change-me-database-password
LEARNING_DB_SCHEMA=learning

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_LEARNING_API_URL=http://localhost:8083
NEXT_PUBLIC_GRADING_API_URL=http://localhost:8082
# Set only when every public request is served over HTTPS (normally behind the
# production reverse proxy). Do not enable this for local HTTP development.
ENFORCE_HTTPS=false
# Comma-separated browser origins permitted to call the backend APIs.
FRONTEND_ALLOWED_ORIGINS=http://localhost:3000
# Emit HSTS only when HTTPS is guaranteed by the deployment edge/proxy.
SECURITY_HEADERS_HSTS_ENABLED=false
