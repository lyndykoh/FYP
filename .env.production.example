# This is non-secret production configuration. Copy it to .env.production.
# Runtime secrets live in ../secrets.txt and are loaded by the Makefile's
# production targets; they are never copied into an image or committed.

# A DNS hostname you control, without scheme, port, or path. Point its A/AAAA
# records at the Docker host before requesting a public certificate.
PUBLIC_APP_DOMAIN=lumina.sg
# Email for the Let's Encrypt account; required by make production-cert.
ACME_EMAIL=admin@example.com

# External persistent Certbot directory, never inside this repository.
# Nginx reads the whole tree, including live/ -> archive/ renewal symlinks.
TLS_DIRECTORY=../letsencrypt
# Defaults follow PUBLIC_APP_DOMAIN. Override for externally managed PEM files
# or the optional VM-only certificate (fullchain.pem and privkey.pem).
# TLS_CERT_FILE=live/lumina.sg/fullchain.pem
# TLS_KEY_FILE=live/lumina.sg/privkey.pem
# Enable only after public HTTPS is verified. Applies to this hostname only.
SECURITY_HEADERS_HSTS_ENABLED=false

# Non-secret application configuration. Paste the provider API key only after
# AI_ENGINE_API_KEY= in ../secrets.txt; never put it in this repository file.
# The application uses the OpenAI-compatible Chat Completions request shape, so
# either OpenAI or DeepSeek can be selected by changing this endpoint/models.
POSTGRES_USER=lumina
POSTGRES_DB=lumina
JWT_EXPIRATION_MS=86400000
# OpenAI profile (one API key serves both marking and vision/OCR requests).
AI_ENGINE_URL=https://api.openai.com/v1/chat/completions
AI_ENGINE_MODEL=gpt-4.1-mini
AI_VISION_MODEL=gpt-4.1-mini
AI_VISION_ENABLED=true
# Default is AI_ENGINE_URL and AI_ENGINE_API_KEY. Override only when the vision
# model uses a separate OpenAI-compatible endpoint or server-only credential.
# AI_VISION_URL=https://api.openai.com/v1/chat/completions
# AI_VISION_API_KEY= in ../secrets.txt; never put it in this repository file.
AI_VISION_TIMEOUT_MS=30000
AI_VISION_MAX_REQUESTS_PER_MINUTE=20
AI_VISION_MAX_ATTEMPTS=3
AI_VISION_RETRY_DELAY_MS=60000
AI_VISION_STALE_RUN_MS=180000
AI_VISION_WORKER_DELAY_MS=5000
# DeepSeek alternative:
# AI_ENGINE_URL=https://api.deepseek.com/chat/completions
# AI_ENGINE_MODEL=deepseek-v4-flash
# AI_VISION_MODEL=deepseek-v4-flash-vision-exp
