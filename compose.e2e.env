# Public, disposable values used only to resolve the base Compose interpolation.
# compose.e2e.yaml replaces service runtime configuration with these offline values.
POSTGRES_USER=e2e
POSTGRES_PW=e2e-password
POSTGRES_DB=e2e
JWT_SECRET=e2e-only-signing-secret-change-before-any-real-deployment
JWT_EXPIRATION_MS=3600000
AI_ENGINE_URL=http://ai-ocr-mock:8080/v1/chat/completions
AI_ENGINE_MODEL=fixture-marking-model
AI_ENGINE_API_KEY=offline-fixture-key
AI_VISION_MODEL=fixture-ocr-model
LEARNING_MARKING_SYNC_KEY=e2e-only-learning-sync-key
# Browser-visible service addresses must match Playwright's 127.0.0.1 base URL.
# They are build arguments for the Next.js fixture image and CSP connect-src.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8081
NEXT_PUBLIC_LEARNING_API_URL=http://127.0.0.1:8083
NEXT_PUBLIC_GRADING_API_URL=http://127.0.0.1:8082
